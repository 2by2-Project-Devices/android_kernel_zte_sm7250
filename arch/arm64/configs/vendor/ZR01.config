# Core
CONFIG_MACH_ZTE_ZR01=y
CONFIG_TASK_DELAY_ACCT=y
CONFIG_PSI_ZTE_PATCH=y
CONFIG_LOG_BUF_SHIFT=21
CONFIG_UID_PAGELIST=y
CONFIG_BIGGER_ORDER_UNMOV=y

# NFC (CXD22XX)
CONFIG_NFC_CXD22XX=y
CONFIG_NFC_CXD22XX_RST=y

# Storage
CONFIG_ZRAM_WRITEBACK=y
# CONFIG_MMC_ZTE_NM is not set
CONFIG_MMC_CQHCI=y

# Security element
CONFIG_SAFECHIP_VEB_A5=y

# Touchscreen (Goodix GTX8 / GT9886)
CONFIG_TS_FIRMWARE="firmware_fony"
CONFIG_TOUCHSCREEN_GOODIX_GTX8=y
CONFIG_TOUCHSCREEN_GOODIX_GTX8_GESTURE=y
CONFIG_TOUCHSCREEN_GOODIX_GTX8_TOOLS=y
CONFIG_TOUCHSCREEN_GOODIX_GTX8_UPDATE=y
# CONFIG_TOUCHSCREEN_GOODIX_BRL is not set
# CONFIG_TOUCHSCREEN_FTS is not set
CONFIG_TP_COMMON_INTERFACE=y
CONFIG_TPD_UFP_MAC=y
CONFIG_DRM_PANEL_NOTIFIER=y
# CONFIG_TOUCHSCREEN_SYNAPTICS_DSX is not set

# Input (SAR sensor, fingerprint)
CONFIG_INPUT_SX9325=y
CONFIG_INPUT_SX9325_1=y
CONFIG_GOODIX_FINGERPRINT=y

# Display (ZTE LCD features)
CONFIG_ZTE_LCD_BACKLIGHT_LEVEL_CURVE=y
CONFIG_ZTE_LCD_HBM_CTRL=y
CONFIG_ZTE_LCD_COLOR_GAMUT_CTRL=y
CONFIG_ZTE_LCD_AOD_BRIGHTNESS_CTRL=y
CONFIG_ZTE_LCD_REG_DEBUG=y
CONFIG_ZTE_LCD_GPIO_CTRL_POWER=y
CONFIG_ZTE_LCD_E1_PANEL=y

# WiFi
CONFIG_QCA_CLD_WLAN=m

# Vendor-specific compilation gates
CONFIG_VENDOR_COMMON_COMPILE=y
CONFIG_VENDOR_SOC_QCOM_COMPILE=y
CONFIG_POWER_VENDOR_COMMON=y
CONFIG_VENDOR_ZTE_MISC=y
CONFIG_VENDOR_BATTERY_CAPACITY_LEARNING=y
CONFIG_VENDOR_CHARGE_ARBITRATE_SERVICE=y
CONFIG_VENDOR_CHARGER_POLICY_SERVICE=y
CONFIG_VENDOR_CPU_RATE_CTRL=y

# Audio (NXP TFA9894 smart PA)
CONFIG_NXP_TFA9894_SMARTPA=y

# Logging
# CONFIG_ANDROID_LOGGER is not set
CONFIG_PRINTK_EXT=y
CONFIG_TIME_FORMAT_ZTELOG=y
CONFIG_VENDOR_IMEM_INFO=y

# Persistent storage
CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_REUSE_EXISTING_BUFFER=y

# Security
# CONFIG_SECURITY_SELINUX_POLICYPROC is not set

# Debug
CONFIG_DYNAMIC_DEBUG=y
